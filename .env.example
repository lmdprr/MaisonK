# ─────────────────────────────────────────────────────────────────────────────
# Keystatic — stockage GitHub (production uniquement)
# En développement, Keystatic écrit directement sur le disque : aucune de ces
# variables n'est nécessaire pour ouvrir /keystatic en local.
# Le dépôt est préfixé NEXT_PUBLIC_ : l'admin est une app cliente et doit savoir
# quel stockage utiliser. Les secrets, eux, restent côté serveur.
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GITHUB_REPO_OWNER=votre-organisation
NEXT_PUBLIC_GITHUB_REPO_NAME=maisonk-v2
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=une-longue-chaine-aleatoire-pour-signer-les-sessions

# ─────────────────────────────────────────────────────────────────────────────
# Images — Cloudflare R2 + transformations
# Sans ces variables, les images sont servies depuis /public (fonctionne, mais
# sans redimensionnement ni AVIF/WebP automatique).
# ─────────────────────────────────────────────────────────────────────────────

# Domaine public du bucket R2, sans slash final (ex. https://cdn.maisonk.fr).
# Laisser vide pour servir les images depuis le site lui-même.
NEXT_PUBLIC_IMAGE_CDN_URL=

# Passe les images par /cdn-cgi/image (redimensionnement + format=auto).
# Nécessite « Transformations » activé sur la zone Cloudflare (domaine custom).
# Plan Free : 5 000 transformations uniques / mois.
NEXT_PUBLIC_IMAGE_TRANSFORMS=false

# Identifiants S3 du bucket R2 — utilisés uniquement par `npm run sync:images`,
# jamais par l'application à l'exécution.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=maisonk-images

# ─────────────────────────────────────────────────────────────────────────────
# Formulaires — Resend (plan gratuit : 100 emails/jour, 3 000/mois)
# ─────────────────────────────────────────────────────────────────────────────
RESEND_API_KEY=
# Doit appartenir à un domaine vérifié dans Resend, sinon l'envoi est refusé.
RESEND_FROM_EMAIL=contact@maisonk.fr

# Secret de chiffrement de l'adresse destinataire des formulaires.
# Générer avec : node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
FORM_TOKEN_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Cloudflare Web Analytics (gratuit, optionnel)
# Alternative : activer Web Analytics depuis le dashboard, sans code.
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CF_BEACON_TOKEN=
